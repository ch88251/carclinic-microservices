@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Container diagram for Car Clinic

Person(customer, "Car Owner", "A car owner who books services for their vehicle")
Person(staff, "Car Clinic Staff", "Staff members who manage service appointments")

System_Boundary(carClinicBoundary, "Car Clinic System") {
    
    Container(webApp, "Web Application", "React", "Allows customers to view and book services, and staff to manage appointments")
    Container(api, "API", "Spring Boot", "Handles all business logic for service scheduling and management")
    ContainerDb(database, "Database", "PostgreSQL", "Stores customer, vehicle, service, and appointment data")
    Container(notificationService, "Notification Service", "Node.js", "Sends email and SMS notifications regarding service appointments")

}

System_Ext(notificationProvider, "Notification Provider", "External service for sending email and SMS")

Rel(customer, webApp, "Uses", "Books service appointments")
Rel(staff, webApp, "Uses", "Manages service appointments")
Rel(webApp, api, "Makes API calls to", "CRUD operations for appointments and vehicles")
Rel(api, database, "Reads/Writes", "Stores and retrieves all necessary data")
Rel(api, notificationService, "Sends notifications via")
Rel(notificationService, notificationProvider, "Uses", "Sends email and SMS notifications")

@enduml